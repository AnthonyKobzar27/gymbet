{
  "expo": {
    "name": "GymBet",
    "slug": "snoozeapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/GYMBETS.png",
    "scheme": "gymbet",
    "userInterfaceStyle": "automatic",
    "description": "Gym training split betting app with PBFT validation - Prove you hit your workout or lose your stake!",
    "privacy": "public",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymbet.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to take workout proof photos for your training split challenge",
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to view and manage workout proof photos",
        "NSPhotoLibraryAddUsageDescription": "We need permission to save workout proof photos to your library",
        "NSUserNotificationsUsageDescription": "We send reminders for your training split challenges and notifications when validators vote on your proofs",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gymbet.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/GYMBETS.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/GYMBETS.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/GYMBETS.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GYMBETS.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f620eba5-77af-410e-856f-3d34eb8c3ff8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f620eba5-77af-410e-856f-3d34eb8c3ff8"
    },
    "owner": "anthonykobzar"
  }
}
